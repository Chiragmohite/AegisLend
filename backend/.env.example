DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aegislend
DB_USER=aegislend
DB_PASSWORD=replace-with-local-development-password
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
REDIS_URL=redis://127.0.0.1:6379/0
CHROMA_URL=http://127.0.0.1:8001
LLM_PROVIDER=disabled
# Run: python scripts/configure_auth.py (from project root).
# JWT_SECRET is intentionally not assigned a shared/default key here.
# JWT_SECRET=<random value generated locally; at least 32 bytes>
ACCESS_TOKEN_MINUTES=15
JWT_ISSUER=aegislend-api
JWT_AUDIENCE=aegislend-client

# Optional supporting services. Core demo works with these disabled.
REDIS_ENABLED=false
CHROMA_ENABLED=false
AUTH_RATE_LIMIT=20
IDS_FAILED_THRESHOLD=5
IDS_BURST_THRESHOLD=60
IDS_ANOMALY_THRESHOLD=0.0
# LLM_PROVIDER=disabled by default (local extractive answers).
# To enable a verified provider, set LLM_PROVIDER=openai-compatible.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# LLM_API_KEY must be injected privately; no default key is supplied.
CREWAI_ENABLED=false

# Enhancement controls: per-client API requests/minute and parallel appointment seats
API_RATE_LIMIT=180
APPOINTMENT_CAPACITY=1

# Correlation thresholds; ML alone never creates account restrictions.
IDS_INCIDENT_THRESHOLD=30
IDS_STUFFING_THRESHOLD=5
